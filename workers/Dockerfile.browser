# Browser worker: isolated from the web service. Playwright image ships browsers + system libs.
FROM mcr.microsoft.com/playwright/python:v1.49.1-noble
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ .
USER pwuser
CMD ["celery", "-A", "app.jobs.celery_app", "worker", "-Q", "browser", "-c", "2", "--loglevel=INFO"]
