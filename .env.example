# ---- Core ----
APP_ENV=development
# Any of postgresql://, postgres:// or postgresql+psycopg:// works; the app always uses the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://hell:hell@localhost:5432/hell_uploads
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
# "inprocess" runs jobs inside the API (simple dev); "celery" sends them to the worker containers
JOB_BACKEND=inprocess
# Secret used to encrypt OAuth tokens at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Owner (single-user mode) ----
# Only this verified Firebase email can ever become the owner.
OWNER_EMAIL=

# ---- Firebase Auth ----
FIREBASE_PROJECT_ID=
# Path to a service-account JSON file, or the JSON itself. Optional for token verification, needed for revocation checks.
FIREBASE_CREDENTIALS=

# ---- AI (optional until you add credits) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Object storage (S3-compatible; leave empty to use local disk) ----
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOCAL_STORAGE_DIR=./storage

# ---- YouTube (optional until you create OAuth credentials) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
# Where the browser returns after Google sign-in (defaults to the first CORS origin)
FRONTEND_URL=http://localhost:5173
# Daily API quota of your Google Cloud project, and units one upload costs. Confirm both in Cloud Console.
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_UPLOAD_COST=1600

# ---- Frontend (frontend/.env) ----
VITE_API_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Narration (any one of these, or upload your own audio) ----
# Piper is free and runs offline: https://github.com/rhasspy/piper
PIPER_BINARY=
PIPER_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
